# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# RAPID_API_KEY: Required for RapidAPI salary and jobs-api14 range queries.
# This is a placeholder key.
# Users configure this via the Secrets panel in the AI Studio UI.
RAPID_API_KEY=MY_RAPID_API_KEY

# LINKEDIN_CLIENT_ID: Required for real-time LinkedIn OAuth 2.0 Profile Sync.
# Configure your LinkedIn Developer App Client ID via the Secrets panel.
LINKEDIN_CLIENT_ID=MY_LINKEDIN_CLIENT_ID

# LINKEDIN_CLIENT_SECRET: Required for real-time LinkedIn OAuth 2.0 token exchange.
# Configure your LinkedIn Developer App Client Secret via the Secrets panel.
LINKEDIN_CLIENT_SECRET=MY_LINKEDIN_CLIENT_SECRET
